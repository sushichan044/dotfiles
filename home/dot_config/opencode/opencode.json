{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "default_agent": "plan",
  "lsp": true,
  "mcp": {
    "servers": {
      "aws-knowledge": {
        "type": "remote",
        "url": "https://knowledge-mcp.global.api.aws"
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "deepwiki": {
        "type": "remote",
        "url": "https://mcp.deepwiki.com/mcp"
      }
    }
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "/tmp/**",
      "effect": "allow"
    }
  ]
}
